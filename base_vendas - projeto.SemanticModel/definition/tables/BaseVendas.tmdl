table BaseVendas
	lineageTag: 004fa2fe-bf43-45c1-b7e1-4654d1cfdd4d

	measure Vendas = SUM(BaseVendas[Valor da venda])
		formatString: #,0
		displayFolder: 1. Base
		lineageTag: 2265f10d-273b-4dc3-a87e-ee4aad371efe

	measure 'Lucro Total' = SUM(BaseVendas[Lucro])
		formatString: #,0
		displayFolder: 1. Base
		lineageTag: dc85a708-ce6f-4030-ba2d-a5d155e08e4d

	measure 'Quantidade Vendida' = SUM(BaseVendas[Quantidade])
		formatString: #,0
		displayFolder: 1. Base
		lineageTag: 9236053f-f61c-4659-b0a7-554f65a2b12a

	measure Pedidos = DISTINCTCOUNT(BaseVendas[Código Nota Fiscal])
		formatString: #,0
		displayFolder: 1. Base
		lineageTag: 08f456a2-e0cf-4bfb-82e3-338dc2d43842

	measure Clientes = DISTINCTCOUNT(BaseVendas[Customer Name])
		formatString: #,0
		displayFolder: 1. Base
		lineageTag: 3f432f2d-3aaa-40a9-a9f7-4be147300ca5

	measure 'Margem %' = DIVIDE([Lucro Total], [Vendas])
		formatString: 0.0%
		displayFolder: 1. Base
		lineageTag: d34bb40d-9bcc-4fb5-844f-bcdeb5da9c00

	measure 'Ticket Médio' = DIVIDE([Vendas], [Pedidos])
		formatString: #,0.00
		displayFolder: 1. Base
		lineageTag: a1265626-6cb5-457e-a67f-6386e751e010

	measure 'Itens por Pedido' = DIVIDE([Quantidade Vendida], [Pedidos])
		formatString: 0.0
		displayFolder: 1. Base
		lineageTag: 9413378f-f8c9-49e4-8590-fd9222bf4809

	measure 'Preço Médio Unitário' = DIVIDE([Vendas], [Quantidade Vendida])
		formatString: #,0.00
		displayFolder: 1. Base
		lineageTag: 95755666-3201-4252-aef9-fd3a772a0b9f

	measure 'Vendas YTD' = TOTALYTD([Vendas], 'Calendário'[Date])
		formatString: #,0
		displayFolder: 2. Tempo
		lineageTag: ab30c6b9-906a-41f9-9991-f3e5e6ad2ed0

	measure 'Vendas Ano Anterior' = CALCULATE([Vendas], SAMEPERIODLASTYEAR('Calendário'[Date]))
		formatString: #,0
		displayFolder: 2. Tempo
		lineageTag: 7144af0c-632a-486a-9fdf-271a66b183d7

	measure 'Crescimento YoY %' = DIVIDE([Vendas] - [Vendas Ano Anterior], [Vendas Ano Anterior])
		formatString: 0.0%;-0.0%;0.0%
		displayFolder: 2. Tempo
		lineageTag: 28cbd078-dd33-4a11-b8fd-13bf4f1982df

	measure 'Média Móvel 3M' = DIVIDE(CALCULATE([Vendas], DATESINPERIOD('Calendário'[Date], MAX('Calendário'[Date]), -3, MONTH)), 3)
		formatString: #,0
		displayFolder: 2. Tempo
		lineageTag: c397cb0e-fd60-4faa-885e-f6618c6b8570

	measure 'Desconto Médio %' = AVERAGE(BaseVendas[Desconto %])
		formatString: 0.0%
		displayFolder: 3. Desconto e Rentabilidade
		lineageTag: 5d6c16cf-52af-4f1d-9489-560551f9bc13

	measure 'Lucro com Desconto > 20%' = CALCULATE([Lucro Total], BaseVendas[Desconto %] > 0.2)
		formatString: #,0;-#,0;0
		displayFolder: 3. Desconto e Rentabilidade
		lineageTag: 3356a6be-3c50-4d7b-817f-78efa956a7fa

	measure 'Linhas com Prejuízo' = CALCULATE(COUNTROWS(BaseVendas), BaseVendas[Lucro] < 0)
		formatString: #,0
		displayFolder: 3. Desconto e Rentabilidade
		lineageTag: 3cb6da32-2917-45f9-ba9c-95297092e055

	measure '% Linhas com Prejuízo' = DIVIDE([Linhas com Prejuízo], COUNTROWS(BaseVendas))
		formatString: 0.0%
		displayFolder: 3. Desconto e Rentabilidade
		lineageTag: c9157ee3-e061-4864-b0a9-94532a02e93b

	measure 'Prejuízo Total' = CALCULATE([Lucro Total], BaseVendas[Lucro] < 0)
		formatString: #,0;-#,0;0
		displayFolder: 3. Desconto e Rentabilidade
		lineageTag: 767dd575-85f7-46db-a996-dc8576d00650

	measure 'Dias Médios para Envio' = AVERAGEX(BaseVendas, DATEDIFF(BaseVendas[Data do Pedido], BaseVendas[Data de Envio], DAY))
		formatString: 0.0
		displayFolder: 4. Logística
		lineageTag: 5184d1c9-c78e-4ff0-bd97-d1b4c46726a1

	measure '% Envio Tardio' = DIVIDE(CALCULATE(COUNTROWS(BaseVendas), BaseVendas[Status do Envio] = "Envio tardio"), COUNTROWS(BaseVendas))
		formatString: 0.0%
		displayFolder: 4. Logística
		lineageTag: f43ab3fc-cfa3-4cb6-b210-1fd612a796b1

	measure '% do Total' = DIVIDE([Vendas], CALCULATE([Vendas], ALL(BaseVendas)))
		formatString: 0.0%
		displayFolder: 5. Participação e Clientes
		lineageTag: 6a982944-980d-4422-8b33-61062a630014

	measure 'Ranking Produto' = RANKX(ALL(BaseVendas[Nome do Produto]), [Vendas])
		formatString: 0
		displayFolder: 5. Participação e Clientes
		lineageTag: 14915e50-ba95-4362-b4fd-48ead513d125

	measure 'Ranking Cliente' = RANKX(ALL(BaseVendas[Customer Name]), [Lucro Total])
		formatString: 0
		displayFolder: 5. Participação e Clientes
		lineageTag: 4fd0311d-66ea-4536-9d12-64b85fca16a7

	measure 'Clientes Recorrentes' = COUNTROWS(FILTER(VALUES(BaseVendas[Customer Name]), [Pedidos] > 1))
		formatString: #,0
		displayFolder: 5. Participação e Clientes
		lineageTag: a4fe4cd1-6734-4d89-aa4f-4f34f0dbf3c3

	measure '% Clientes Recorrentes' = DIVIDE([Clientes Recorrentes], [Clientes])
		formatString: 0.0%
		displayFolder: 5. Participação e Clientes
		lineageTag: 11470e34-dd7a-4f21-95b8-65f6c4ef6a15

	/// Formatação condicional: vermelho para lucro negativo, cinza para o restante.
	measure 'Cor Lucro' = IF([Lucro Total] < 0, "#D6361F", "#C9C5BC")
		displayFolder: 6. Formatação
		lineageTag: 15f15171-780f-4853-8c2d-01f5eceb0fc2

	/// Formatação condicional: azul para o último ano com vendas, cinza para os demais.
	measure 'Cor Ano Destaque' =
			VAR UltimoAno = CALCULATE(MAX('Calendário'[Ano]), ALL('Calendário'))
			RETURN IF(MAX('Calendário'[Ano]) = UltimoAno, "#1F5EFF", "#C9C5BC")
		displayFolder: 6. Formatação
		lineageTag: 8fd8c72a-e723-47b0-8c96-42cf6bb3c537

