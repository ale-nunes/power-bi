	/// Faixa de desconto aplicada à linha, usada no gráfico de lucro por desconto.
	column 'Faixa de Desconto' = SWITCH(TRUE(), BaseVendas[Desconto %] = 0, "1. Sem desconto", BaseVendas[Desconto %] <= 0.2, "2. Até 20%", BaseVendas[Desconto %] <= 0.4, "3. 20% a 40%", "4. Acima de 40%")
		dataType: string
		displayFolder: Apoio
		lineageTag: fa00b8d4-4860-4af6-b33d-5daa8748eb81
		summarizeBy: none

	partition BaseVendas = m
		mode: import
		source =
				let
				  Origem = Csv.Document(File.Contents("C:\Users\Alê\Downloads\BaseVendas.csv"), [Delimiter = ";", Columns = 19, Encoding = 65001, QuoteStyle = QuoteStyle.None]),
				  #"Cabeçalhos promovidos" = Table.PromoteHeaders(Origem, [PromoteAllScalars = true]),
				  #"Tipo de coluna alterado" = Table.TransformColumnTypes(#"Cabeçalhos promovidos", {{"Categoria", type text}, {"Cidade", type text}, {"Pais", type text}, {"Customer Name", type text}, {"Data do Pedido", type date}, {"Código Nota Fiscal", type text}, {"Código Postal", Int64.Type}, {"Nome do Produto", type text}, {"Região", type text}, {"Segmento", type text}, {"Data de Envio", type date}, {"Tipo de Envio", type text}, {"Status do Envio", type text}, {"Estado", type text}, {"Subcategoria", type text}, {"Desconto %", type number}, {"Lucro", Int64.Type}, {"Quantidade", Int64.Type}, {"Valor da venda", Int64.Type}})
				in
				  #"Tipo de coluna alterado"

	annotation PBI_ResultType = Table

